{% for section in sections %}
{% set section_words = section.get('words', []) %}
{% if section.get('title') and sections | length > 1 %}
\vspace{0.2em}
\begin{center}
{\Large\bfseries\textcolor{accentdark}{ {{ section.get('title') | tex_escape }} }}\hspace{0.5em}{\normalsize\textcolor{inkmuted}{（共 {{ section_words | length }} 个）}}
\end{center}
\vspace{0.3em}
{% endif %}

{% for word in section_words %}
{% set word_name = word.get('name', '') %}
{% set word_pinyin = word.get('pinyin', '') %}
{% set word_type = word.get('type', '') %}
{% set word_baobian = word.get('baobian', '') %}
{% set word_structure = word.get('structure', '') %}
{% set word_definition = word.get('definition_info') %}
{% set word_detail = word.get('detail_means') %}
{% set word_liju = word.get('liju') %}
{% set word_synonyms = word.get('synonyms') %}
{% set word_antonym = word.get('antonym') %}
{% set word_chuchu = word.get('chu_chu') %}
{% set word_yinzheng = word.get('yin_zheng') %}
{% set word_frequency = word.get('frequency', 0) %}

\begin{wordcard}[{{ word_name | tex_escape }}]
{{ card_font }}
{% if word_pinyin %}
\noindent{\large\textcolor{accent}{\textit{ {{ word_pinyin | tex_escape }} }}}\hspace{1em}
{% endif %}
{% if word_type %}{{ wordtag('accent', word_type | tex_escape) }}\hspace{0.3em}{% endif %}
{% if word_baobian %}{% set baobian_color = 'tagpos' if word_baobian == '褒义' else ('tagneg' if word_baobian == '贬义' else 'tagneu') %}{{ wordtag(baobian_color, word_baobian | tex_escape) }}\hspace{0.3em}{% endif %}
{% if word_structure %}{{ wordtag('ruleline', word_structure | tex_escape) }}{% endif %}
{% if word_frequency > 0 %}\hspace{0.5em}{\fontsize{7pt}{8.5pt}\selectfont\textcolor{inkmuted}{频次 {{ word_frequency }}}}{% endif %}

{% if word_definition or word_detail %}
\vspace{0.5em}
\noindent\textcolor{accentdark}{\textbf{释义：}}\par\vspace{0.2em}
{%- if word_definition %}
\noindent{}{{ render_def(word_definition) }}
{%- endif -%}
{%- if word_detail -%}
{%- if word_definition %}\par\vspace{0.2em}{% endif -%}
\noindent{}{{ render_detail_means(word_detail) }}
{%- endif -%}
\par\vspace{0.3em}
{% endif %}

{% if word_liju is iterable and word_liju is not string and word_liju | length > 0 %}
\vspace{0.4em}
\noindent\textcolor{accentdark}{\textbf{例句：}}
\begin{itemize}[leftmargin=1.5em,itemsep=0.15em,topsep=0.15em,parsep=0pt]
{{ render_liju(word_liju) }}
\end{itemize}
{% endif %}

{% if show_full_detail %}
{% if word_chuchu %}
\vspace{0.3em}
\noindent\textcolor{accentdark}{\textbf{出处：}}{{ render_source(word_chuchu) }}
{% endif %}
{% if word_yinzheng %}
\\[0.15em]
\noindent\textcolor{accentdark}{\textbf{引证：}}{{ render_source(word_yinzheng) }}
{% endif %}
{% if word_synonyms is iterable and word_synonyms is not string and word_synonyms | length > 0 %}
\vspace{0.3em}
\noindent\textcolor{accentdark}{\textbf{近义词：}}{{ render_word_list(word_synonyms) }}
{% endif %}
{% if word_antonym is iterable and word_antonym is not string and word_antonym | length > 0 %}
\\[0.15em]
\noindent\textcolor{accentdark}{\textbf{反义词：}}{{ render_word_list(word_antonym) }}
{% endif %}
{% endif %}

\end{wordcard}

{% endfor %}
{% if not loop.last %}
\vspace{0.5em}
{% endif %}
{% endfor %}

