\usepackage[most]{tcolorbox}
\usepackage{setspace}
\usepackage{tikz}
\usetikzlibrary{calc}

\definecolor{accent}{HTML}{ {{ colors.get('accent') }} }
\definecolor{accentdark}{HTML}{ {{ colors.get('accent_dark') }} }
\definecolor{accentsoft}{HTML}{ {{ colors.get('accent_soft') }} }
\definecolor{ruleline}{HTML}{ {{ colors.get('rule') }} }
\definecolor{inkmuted}{HTML}{6A6A6A}
\definecolor{tagpos}{HTML}{2E7D32}
\definecolor{tagneg}{HTML}{C62828}
\definecolor{tagneu}{HTML}{6A6A6A}

\newtcolorbox{wordcard}[1][]{
  breakable,
  enhanced,
  colback=white,
  colframe=ruleline,
  boxrule=0.4pt,
  leftrule=3pt,
  arc=3pt,
  left=10pt, right=8pt, top=7pt, bottom=7pt,
  before skip=0.6em,
  after skip=0.6em,
  fonttitle=\large\bfseries,
  coltitle=accentdark,
  title=#1,
}

{% macro wordtag(color, label) -%}
\tikz[baseline=(tag.base)]\node[fill={{ color }}!12,text={{ color }},rounded corners=2pt,inner xsep=5pt,inner ysep=1.5pt,font=\fontsize{7.5pt}{9pt}\selectfont](tag){ {{ label }} };
{%- endmacro %}

\setlength{\parindent}{0pt}
\setstretch{ {{ card_stretch.get(layout_mode, '1.22') }} }

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{ {% if show_header %}0.4pt{% else %}0pt{% endif %} }
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{ruleline}\leaders\hrule height \headrulewidth\hfill}}
{% if show_header %}
\fancyhead[{{ header_left_pos }}]{\small\textcolor{accentdark}{ {{ header_left | tex_escape }} }}
\fancyhead[{{ header_right_pos }}]{\small\textcolor{inkmuted}{ {{ header_right | tex_escape }} | {{ variant_label | tex_escape }} }}
{% endif %}
{% if show_page_number %}
\fancyfoot[{{ page_number_position }}]{\small\textcolor{inkmuted}{第 \thepage 页\quad 共 \pageref*{LastPage} 页}}
{% endif %}

\begin{document}

