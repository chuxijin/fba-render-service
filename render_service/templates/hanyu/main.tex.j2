{% set variant = render_variant | default('questions_only') %}
{% set metadata_data = metadata | default({}) %}
{% set options_data = options | default({}) %}
{% set book_data = book | default({}) %}
{% set paper_data = paper | default({}) %}
{% set sections = paper_data.get('sections', []) %}
{% set flat_words = paper_data.get('words', []) %}
{% if not sections and flat_words %}
{% set sections = [{'title': '', 'words': flat_words}] %}
{% endif %}
{% set show_full_detail = variant == 'combined_appendix' %}
{% set show_cover = not options_data.get('no_cover', False) %}
{% set layout_mode = options_data.get('layout_mode', 'standard') %}
{% set paper_size_raw = (metadata_data.get('paper_size') or options_data.get('paper_size') or 'A4') | string | lower %}
{% set paper_size_map = {'a4': 'a4paper', 'a5': 'a5paper', 'b5': 'b5paper', 'letter': 'letterpaper'} %}
{% set paper_size = paper_size_map.get(paper_size_raw, 'a4paper') %}
{% set margin_map = {'compact': '1.5cm', 'standard': '1.8cm', 'loose': '2.1cm'} %}
{% set page_margin = metadata_data.get('page_margin', margin_map.get(layout_mode, '1.8cm')) %}
{% set theme = options_data.get('theme', 'teal') %}
{% set theme_map = {
    'blue': {'accent': '1F4E79', 'accent_dark': '15334D', 'accent_soft': 'EAF2F9', 'rule': '8FB7D9'},
    'green': {'accent': '2E6A57', 'accent_dark': '1E4338', 'accent_soft': 'E8F3EF', 'rule': '9BC8B6'},
    'orange': {'accent': 'AF5A2A', 'accent_dark': '6E381A', 'accent_soft': 'F9EEE7', 'rule': 'E1B292'},
    'purple': {'accent': '6B4A8C', 'accent_dark': '452C5F', 'accent_soft': 'F0EAF7', 'rule': 'C9B4DE'},
    'teal': {'accent': '01847C', 'accent_dark': '015D57', 'accent_soft': 'E5F5F4', 'rule': '7FC8C4'},
    'crimson': {'accent': '8C2B2B', 'accent_dark': '5C1A1A', 'accent_soft': 'F7EAEA', 'rule': 'D49A9A'},
    'indigo': {'accent': '38558F', 'accent_dark': '243860', 'accent_soft': 'EBF0F7', 'rule': '97AFCF'},
    'amber': {'accent': 'B7791F', 'accent_dark': '7A5200', 'accent_soft': 'FFF7E6', 'rule': 'E8C478'}
} %}
{% set colors = theme_map.get(theme, theme_map['teal']) %}
{% set card_stretch = {'compact': '1.12', 'standard': '1.22', 'loose': '1.35'} %}
{% set card_font_map = {'compact': '\\normalsize', 'standard': '\\normalsize', 'loose': '\\large'} %}
{% set card_font = card_font_map.get(layout_mode, '\\normalsize') %}
{% set total_words = namespace(count=0) %}
{% for section in sections %}
{% set total_words.count = total_words.count + (section.get('words', []) | length) %}
{% endfor %}
{% set double_sided = options_data.get('double_sided') or metadata_data.get('double_sided', False) %}
{% set show_header = metadata_data.get('show_header', True) %}
{% set show_page_number = metadata_data.get('show_page_number', True) %}
{% set variant_labels = {
    'questions_only': '词汇卡片版',
    'combined_appendix': '词汇详解版'
} %}
{% set variant_label = variant_labels.get(variant, '词汇卡片版') %}
{% set header_left = metadata_data.get('header_left', book_data.get('title', '汉语词汇手册')) %}
{% set header_right = metadata_data.get('header_right', variant_label) %}
{% set template_name = template_manifest.get('name', '汉语词汇手册') if template_manifest else '汉语词汇手册' %}
{% if double_sided %}
{% set page_number_position_map = {'left': 'LO,RE', 'center': 'C', 'right': 'RO,LE'} %}
{% set header_left_pos = 'LO,RE' %}
{% set header_right_pos = 'RO,LE' %}
{% else %}
{% set page_number_position_map = {'left': 'L', 'center': 'C', 'right': 'R'} %}
{% set header_left_pos = 'L' %}
{% set header_right_pos = 'R' %}
{% endif %}
{% set page_number_position_raw = (metadata_data.get('page_number_position', 'center') or 'center') | string | lower %}
{% set page_number_position = page_number_position_map.get(page_number_position_raw, 'C') %}

{% macro render_def(def_info) -%}
{% if def_info is string %}
{{ def_info | tex_escape }}
{% elif def_info is mapping %}
{% if def_info.get('text') %}{{ def_info.get('text') | tex_escape }}{% endif %}
{% if def_info.get('definitions') %}
{% for d in def_info.get('definitions', []) %}
{% if d is string %}{{ d | tex_escape }}{% elif d is mapping %}{{ d.get('text', '') | tex_escape }}{% endif %}{% if not loop.last %}；{% endif %}
{% endfor %}
{% endif %}
{% elif def_info is iterable and def_info is not string %}
{% for d in def_info %}
{% if d is string %}{{ d | tex_escape }}{% elif d is mapping %}{{ d.get('text', '') | tex_escape }}{% endif %}{% if not loop.last %}；{% endif %}
{% endfor %}
{% endif %}
{%- endmacro %}

{% macro render_detail_means(detail) -%}
{% if detail is string %}{{ detail | tex_escape }}
{%- elif detail is mapping %}
{%- for pos, meanings in detail.items() -%}
{% if pos and pos != 'text' %}{\textbf{（{{ pos | tex_escape }}）}}{% endif %}{% if meanings is string %}{{ meanings | tex_escape }}{% elif meanings is iterable %}{% for m in meanings %}{% if m is string %}{{ m | tex_escape }}{% elif m is mapping %}{{ m.get('text', '') | tex_escape }}{% endif %}{% if not loop.last %}；{% endif %}{% endfor %}{% endif %}{% if not loop.last %} \\ {% endif %}
{%- endfor %}
{%- elif detail is iterable and detail is not string %}
{%- for item in detail -%}
{% if item is string %}{{ item | tex_escape }}{%- elif item is mapping -%}{% if item.get('pos') %}{\textbf{（{{ item.get('pos') | tex_escape }}）}}{% endif %}{{ item.get('text', item.get('meaning', '')) | tex_escape }}{% endif %}{% if not loop.last %} \\ {% endif %}
{%- endfor %}
{%- endif -%}
{%- endmacro %}

{% macro render_liju(examples) -%}
{% if examples is iterable and examples is not string %}
{% for ex in examples %}
{% set ex_text = ex if ex is string else ex.get('text', ex.get('sentence', '')) %}
{% if ex_text %}
\item {{ ex_text | tex_escape }}
{% endif %}
{% endfor %}
{% endif %}
{%- endmacro %}

{% macro render_word_list(word_list) -%}
{% if word_list is iterable and word_list is not string %}
{% for w in word_list %}{% if w is string %}{{ w | tex_escape }}{% elif w is mapping %}{{ w.get('name', w.get('word', '')) | tex_escape }}{% endif %}{% if not loop.last %}、{% endif %}{% endfor %}
{% elif word_list is string %}
{{ word_list | tex_escape }}
{% endif %}
{%- endmacro %}

{% macro render_source(src) -%}
{% if src is string %}
{{ src | tex_escape }}
{% elif src is mapping %}
{% if src.get('text') %}{{ src.get('text') | tex_escape }}{% endif %}{% if src.get('source') %}（{{ src.get('source') | tex_escape }}）{% endif %}
{% endif %}
{%- endmacro %}

\documentclass[11pt,{{ paper_size }}{% if double_sided %},twoside{% endif %}]{ctexart}
\usepackage[{{ paper_size }},margin={{ page_margin }}]{geometry}
\usepackage{amsmath,amssymb}
\usepackage[table]{xcolor}
\usepackage{enumitem}
\usepackage{tabularx}
\usepackage{array}
\usepackage{fancyhdr}
\usepackage{hyperref}
